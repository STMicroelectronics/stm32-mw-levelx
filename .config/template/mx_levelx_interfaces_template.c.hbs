{{~assign 'levelx_context' (@root.SWConfigurationAPI.getInstancesConfiguration @root.levelxFilter)~}}
{{~assign 'levelx_cxt' @root.levelx_context.[0].settings.parameters~}}
{{~log "LevelX Config template levelx_cxt:" (toJSON @root.levelx_cxt)~}}
{{~assign 'used_components_levelx' (@root.SWProjectAPI.getUsedComponents 'asObject' cgroup="LevelX")~}}
