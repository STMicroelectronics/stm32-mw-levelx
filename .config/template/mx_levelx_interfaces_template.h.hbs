/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_LEVELX_INTERFACES_H
#define MX_LEVELX_INTERFACES_H

/* Includes ------------------------------------------------------------------*/
{{~#each levelx_cxt.interfaces~}}
  {{~#with logical_config~}}
  {{~#if (eq interface_type "MX66UW1G45G_NOR_FLASH_INTERFACE")~}}
    {{~assign "ifacePrefix" "mx66uw1g45g"~}}
    {{~assign "ifaceConstPrefix" "MX66UW1G45G"~}}
  {{~else if (eq interface_type "MX25LM51245G_NOR_FLASH_INTERFACE")~}}
    {{~assign "ifacePrefix" "mx25lm51245g"~}}
    {{~assign "ifaceConstPrefix" "MX25LM51245G"~}}
  {{~else if (eq interface_type "W25Q128J_NOR_FLASH_INTERFACE")~}}
      {{~assign "ifacePrefix" "w25q128j"~}}
      {{~assign "ifaceConstPrefix" "W25Q128J"~}}
  {{~else if (eq interface_type "W25N01GVXX_NAND_FLASH_INTERFACE")~}}
    {{~assign "ifacePrefix" "w25n01gvxx"~}}
    {{~assign "ifaceConstPrefix" "W25N01GVXX"~}}
  {{~else~}}
    {{~assign "ifacePrefix" "unknown"~}}
    {{~assign "ifaceConstPrefix" "UNKNOWN"~}}
    {{~log "Warning: interface_type unknown, assigned ifacePrefix='unknown'"~}}
  {{~/if~}}
    {{~#if (eq transfer_mode "POLLING")~}}
      {{~assign "transferModeSuffix" "polling"~}}
    {{~else if (eq transfer_mode "DMA_NO_OS")~}}
      {{~assign "transferModeSuffix" "dma_no_os"~}}
    {{~else if (eq transfer_mode "DMA_OS")~}}
      {{~assign "transferModeSuffix" "dma_os"~}}
    {{~/if}}

{{#if (eq interface_type "W25N01GVXX_NAND_FLASH_INTERFACE")}}
#include "mx_{{@root.ifacePrefix}}.h"
#include "stm32_lx_{{@root.ifacePrefix}}_nand_flash_{{@root.transferModeSuffix}}_driver.h"
{{else if (or (eq interface_type "MX66UW1G45G_NOR_FLASH_INTERFACE") (eq interface_type "MX25LM51245G_NOR_FLASH_INTERFACE") (eq interface_type "W25Q128J_NOR_FLASH_INTERFACE"))}}
#include "mx_{{@root.ifacePrefix}}.h"
#include "stm32_lx_{{@root.ifacePrefix}}_nor_flash_{{@root.transferModeSuffix}}_driver.h"
{{/if}}
  {{/with}}
{{/each}}

{{#each levelx_cxt.interfaces}}
  {{#with logical_config}}
/* Define the list of the LevelX generic functions to be called by the example */
    {{#if (eq interface_type "W25N01GVXX_NAND_FLASH_INTERFACE")}}
#define mx_lx_nand_flash_driver_{{@index}}_initialize  stm32_lx_{{@root.ifacePrefix}}_nand_flash_{{@root.transferModeSuffix}}_driver_initialize

/* Define the functions to get the levelx interface context */
VOID *mx_lx_nand_flash_driver_{{@index}}_get_ctx(VOID);
    {{else if (or (eq interface_type "MX66UW1G45G_NOR_FLASH_INTERFACE") (eq interface_type "MX25LM51245G_NOR_FLASH_INTERFACE") (eq interface_type "W25Q128J_NOR_FLASH_INTERFACE"))}}
#define mx_lx_nor_flash_driver_{{@index}}_initialize  stm32_lx_{{@root.ifacePrefix}}_nor_flash_{{@root.transferModeSuffix}}_driver_initialize

/* Define the functions to get the levelx interface context */
VOID *mx_lx_nor_flash_driver_{{@index}}_get_ctx(VOID);
    {{/if}}
  {{/with}}
{{/each}}

{{#if (isFilexNorFlashEnabled used_components_filex)}}
#define LX_NOR_FLASH_0_SIZE   ({{@root.ifaceConstPrefix}}_FLASH_SIZE - {{@root.ifaceConstPrefix}}_BLOCK_SIZE)

#ifndef LX_NOR_DISABLE_EXTENDED_CACHE

#ifdef LX_NOR_ENABLE_MAPPING_BITMAP

#define LX_NOR_FLASH_0_BITMAP_CACHE_SIZE  ({{@root.ifaceConstPrefix}}_FLASH_SIZE/LX_NOR_SECTOR_SIZE + 31) / 32
#else
#define LX_NOR_FLASH_0_BITMAP_CACHE_SIZE  0

#endif /* LX_NOR_ENABLE_MAPPING_BITMAP */

#ifdef LX_NOR_ENABLE_OBSOLETE_COUNT_CACHE

#define LX_NOR_FLASH_0_OBSOLETE_COUNT_CACHE_SIZE  ({{@root.ifaceConstPrefix}}_FLASH_SIZE/{{@root.ifaceConstPrefix}}_BLOCK_64K)*sizeof(LX_NOR_OBSOLETE_COUNT_CACHE_TYPE) / 4
#else
#define LX_NOR_FLASH_0_OBSOLETE_COUNT_CACHE_SIZE  0

#endif /* LX_NOR_ENABLE_OBSOLETE_COUNT_CACHE */
#endif /* LX_NOR_DISABLE_EXTENDED_CACHE */

{{/if}}
{{#if (isFilexNandFlashEnabled used_components_filex)}}
#define LX_NAND_FLASH_0_SECTOR_SIZE {{@root.ifaceConstPrefix}}_DATA_PAGE_SIZE
#define LX_NAND_FLASH_0_SIZE ({{@root.ifaceConstPrefix}}_FLASH_SIZE - {{@root.ifaceConstPrefix}}_DATA_PAGE_SIZE)
{{/if}}

#endif /* MX_LEVELX_INTERFACES_H */