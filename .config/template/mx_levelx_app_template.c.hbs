  lx_nor_flash_open_extended(&NORFlashObj_{{@index}}, "nor flash_{{@index}}", mx_lx_nor_flash_driver_{{@index}}_initialize, mx_lx_nor_flash_driver_{{@index}}_get_ctx());
    {{/if}}
    {{#if applicative.nand_flash_extended_format}}
  /* Format the NAND flash driver */
