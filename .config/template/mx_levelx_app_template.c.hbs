/**
  * @brief  Application LevelX Initialization.
  * @param  None
  * @retval 0 on success -1 otherwise
  */
UINT app_levelx_init(VOID)
{
  UINT ret;
{{#if generateMainInit}}
  /* Create the {{LevelX_App_Task_Entry_Name}} */
  ret = xTaskCreate({{levelx_cxt.core.applicative.levelx_app_task_entry_name}}, LevelX_App_Task_Name, LevelX_App_Stack_Size, (VOID *) NULL,
                    LevelX_App_Task_Priority, &lx_app_task);
  if (ret != pdPASS)
  {
    return -1;
  }
{{/if}}
{{#each levelx_cxt.interfaces}}
  {{#with logical_config}}
    {{#if applicative.generate_levelx_interface_init_code}}
  /* Create the {{applicative.levelx_interface_app_task_entry_name}} */
  ret = xTaskCreate({{applicative.levelx_interface_app_task_entry_name}}, LevelX_Interface_App_Task_Name_{{@index}}, LevelX_Interface_App_Stack_Size_{{@index}}, (VOID *) NULL,
                    LevelX_Interface_App_Task_Priority_{{@index}}, &lx_interface_task_{{@index}});
  if (ret != pdPASS)
  {
    return -1;
  }
    {{/if}}
  {{/with}}
{{/each}}
{{#if nor_enabled}}
  /* Initialize LevelX NOR flash */
  ret = lx_nor_flash_initialize();
  if (ret != LX_SUCCESS)
  {
    return -1;
  }
{{/if}}
{{#if nand_enabled}}
  /* Initialize LevelX NAND flash */
  ret = lx_nand_flash_initialize();
  if (ret != LX_SUCCESS)
  {
    return -1;
  }
{{/if}}

{{#if (not generateMainInit)}}
{{#each levelx_cxt.interfaces}}
  {{#with logical_config}}
    {{#if applicative.nor_flash_format}}
  /* Format the NOR flash driver */
  ret = lx_nor_flash_format(&NORFlashObj_{{@index}}, "nor flash_{{@index}}", mx_lx_nor_flash_driver_{{@index}}_initialize, mx_lx_nor_flash_driver_{{@index}}_get_ctx());
  if (ret != LX_SUCCESS)
  {
    return -1;
  }
    {{/if}}

    {{#if applicative.nor_flash_extended_open}}
  /* Open the NOR flash driver */
  ret = lx_nor_flash_open_extended(&NORFlashObj_{{@index}}, "nor flash_{{@index}}", mx_lx_nor_flash_driver_{{@index}}_initialize, mx_lx_nor_flash_driver_{{@index}}_get_ctx());
  if (ret != LX_SUCCESS)
  {
    return -1;
  }
    {{/if}}
    {{#if applicative.nand_flash_extended_format}}
  /* Format the NAND flash driver */
  ret = lx_nand_flash_format_extended(&NANDFlashObj_{{@index}}, "nand flash{{@index}}", mx_lx_nand_flash_driver_{{@index}}_initialize, mx_lx_nand_flash_driver_{{@index}}_get_ctx(), memory_ptr_{{@index}}, sizeof(memory_ptr_{{@index}}));
  if (ret != LX_SUCCESS)
  {
    return -1;
  }
     {{/if}}
      {{#if applicative.nand_flash_extended_open}}
  /* Open the NAND flash driver */
  ret = lx_nand_flash_open_extended(&NANDFlashObj_{{@index}}, "nand flash{{@index}}", mx_lx_nand_flash_driver_{{@index}}_initialize, mx_lx_nand_flash_driver_{{@index}}_get_ctx(), memory_ptr_{{@index}}, sizeof(memory_ptr_{{@index}}));
  if (ret != LX_SUCCESS)
  {
    return -1;
  }
      {{/if}}
  {{/with}}
{{/each}}
{{/if}}

  return LX_SUCCESS;
}

{{#if generateMainInit}}
