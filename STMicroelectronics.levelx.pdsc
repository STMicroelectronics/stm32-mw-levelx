        <file category="header" name="interfaces/nor/mx25lm51245g/stm32_lx_mx25lm51245g_nor_flash_polling_driver.h"/>
        <file category="include" name="interfaces/nor/"/>
        <file category="include" name="interfaces/nor/mx25lm51245g/"/>
      </files>
    </component>
    <component Cclass="File System" Cgroup="LevelX" Csub="mx25lm51245g_nor_dma_no_os_itf" condition="USE MX25LM51245G DMA NO OS" Cversion="6.4.1" maxInstances="1">
      <description>DMA no os interface for NOR flash mx25lm51245g</description>
      <files>
        <file category="source" name="interfaces/nor/mx25lm51245g/stm32_lx_mx25lm51245g_nor_flash_dma_no_os_driver.c"/>
