    <!-- START: STMicroelectronics MW LevelX CODE GEN -->
    <component generator="levelx_mx2codegen" Cclass="File System" Cgroup="STM32CubeMX2 Config" Csub="LevelX" Cversion="2.0.0" condition="LX Core condition">
      <description>STMicroelectronics: STM32Cube Configuration Code Generation for LevelX</description>
      <environments>
        <environment name="STM32Cube">
        </environment>
      </environments>
      <files>
        <file category="genAsset" name=".config/gen_code.bat"/>
        <file category="genAsset" name=".config/gen_code.sh"/>
        <file category="genAsset" name=".config/STMicroelectronics.levelx.gpdsc.hbs"/>
        <file category="genAsset" name=".config/template/lx_user_template.h.hbs"/>
        <file category="genAsset" name=".config/template/mx_levelx_app_template.c.hbs"/>
        <file category="genAsset" name=".config/template/mx_levelx_app_template.h.hbs"/>
        <file category="genAsset" name=".config/template/mx_levelx_interfaces_template.c.hbs"/>
        <file category="genAsset" name=".config/template/mx_levelx_interfaces_template.h.hbs"/>
        <file category="genAsset" name=".config/levelx_config_parameters.json"/>
        <file category="genAsset" name=".config/template/helpers/levelx_helpers.js"/>
        <!-- License files -->
        <file category="genAsset" name=".config/template/partials/LICENSE_partial.hbs"/>
        <file category="genAsset" name=".config/template/license/mx_levelx_license_template.md.hbs"/>
      </files>
    </component>
  </components>
</package>
