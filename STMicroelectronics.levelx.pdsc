      </files>
    </component>
    <component Cclass="File System" Cgroup="LevelX" Csub="No_OS" Cversion="6.4.1">
      <description>LevelX Standalone Mode </description>
      <files>
        <!-- standalone mode -->
        <file category="include" name="ports/generic/inc/"/>
      </files>
    </component>
    <!-- levelx mx25lm51245g nor flash interface components -->
    <component Cclass="File System" Cgroup="LevelX" Csub="mx25lm51245g_nor_polling_itf" condition="USE MX25LM51245G POLLING" Cversion="6.4.1" maxInstances="1">
